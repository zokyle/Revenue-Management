 "changed_from_gl_pins_h": [
  {
   "signal": "CAM_L_PWDN",
   "from": "PH0",
   "to": "PC2",
   "reason": "PC2 is on the left half of the camera-facing edge; PH0 goes to the right camera"
  },
  {
   "signal": "CAM_L_SCL",
   "from": "PB3",
   "to": "PC3",
   "reason": "PB3 is needed for SPI1_SCK next to the flash; PC3 faces the cameras"
  },
  {
   "signal": "CAM_PWR_EN",
   "from": "PD2",
   "to": "PH3",
   "reason": "takes the BOOT0 pad instead of NTC_BIAS: the 10k BOOT0 pull-down would load the ratiometric NTC bias (0.28 mA extra through the pin's on-resistance, about 0.5 K error at 0 C); a rail enable does not care"
  },
  {
   "signal": "CAM_R_PWDN",
   "from": "PC12",
   "to": "PH0",
   "reason": "camera-facing edge, right half; a quasi-static signal is the right neighbour for OSC32_OUT (pad 4)"
  },
  {
   "signal": "CAM_R_SCL",
   "from": "PA10",
   "to": "PC0",
   "reason": "PA10 is on the battery-facing edge; PC0 faces the cameras, PA10 takes FLASH_CS"
  },
  {
   "signal": "CAM_SCCB_SDA",
   "from": "PB5",
   "to": "PC1",
   "reason": "PB5 is needed for SPI1_MOSI next to the flash; PC1 faces the cameras"
  },
  {
   "signal": "FLASH_CS",
   "from": "PA15",
   "to": "PA10",
   "reason": "PA10 is the ROM bootloader's USART1_RX: the chip-select pull-up keeps it at idle-high during the detection phase; PA15 goes to the grain LEDs"
  },
  {
   "signal": "GRAIN_CP0",
   "from": "PC0",
   "to": "PA9",
   "reason": "PC0-PC3 face the cameras and carry SCCB / PWDN now; PA9, PA15, PC10, PC12, PD2 are the corner next to the LED ring"
  },
  {
   "signal": "GRAIN_CP1",
   "from": "PC1",
   "to": "PA15",
   "reason": "see GRAIN_CP0"
  },
  {
   "signal": "GRAIN_CP2",
   "from": "PC2",
   "to": "PC12",
   "reason": "see GRAIN_CP0"
  },
  {
   "signal": "GRAIN_CP3",
   "from": "PC3",
   "to": "PD2",
   "reason": "see GRAIN_CP0"
  },
  {
   "signal": "IMU_INT1",
   "from": "PC13",
   "to": "PC5",
   "reason": "PC5 faces the IMU and is a wake-up pin (WKUP5); PC13 is on the far corner next to the crystal"
  },
  {
   "signal": "IMU_INT2",
   "from": "PC5",
   "to": "PA7",
   "reason": "PC5 is taken by IMU_INT1; PA7 is on the same edge (and is WKUP8)"
  },
  {
   "signal": "NTC_BIAS",
   "from": "PH3",
   "to": "PA5",
   "reason": "PH3 carries the 10k BOOT0 pull-down, which would load the bias (see CAM_PWR_EN); PA5 is two pads from NTC_SENSE"
  },
  {
   "signal": "SPI1_MOSI",
   "from": "PA7",
   "to": "PB5",
   "reason": "see SPI1_SCK"
  },
  {
   "signal": "SPI1_SCK",
   "from": "PA5",
   "to": "PB3",
   "reason": "PB3 / PB4 / PB5 are three adjacent pads on the edge that faces the flash; PA5 is on the opposite edge"
  },
  {
   "signal": "VBUS_SENSE",
   "from": "PA9",
   "to": "PC13",
   "reason": "PA9 goes to the grain LEDs; PC13 is a wake-up pin (cradle insertion can wake from Shutdown) and a static signal is the right neighbour for OSC32_IN (pad 3); PC13 may only sink 3 mA: it is an input here"
  }
 ],
