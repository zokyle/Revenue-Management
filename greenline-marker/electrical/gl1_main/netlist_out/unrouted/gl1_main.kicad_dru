(version 1)
# Generated by gleda from the design's net classes - do not edit.
# KiCad checks clearances per net class by itself; these rules add the
# minimum track width of each net class (and of nets with a narrower
# width override).  Later rules take precedence.
(rule "gleda min track width of net class Default"
  (condition "A.NetClass == 'Default'")
  (constraint track_width (min 0.15mm)))
(rule "gleda min track width of net class CamPower"
  (condition "A.NetClass == 'CamPower'")
  (constraint track_width (min 0.15mm)))
(rule "gleda min track width of net class Fine"
  (condition "A.NetClass == 'Fine'")
  (constraint track_width (min 0.1mm)))
(rule "gleda min track width of net class Power"
  (condition "A.NetClass == 'Power'")
  (constraint track_width (min 0.15mm)))
# Fine net classes may use their fine geometry only for copper that lies
# completely inside one of the fine areas (rule areas of the board):
# elsewhere their tracks and vias need the standard width and clearance.
(rule "gleda fine class CamPower outside the fine areas"
  (condition "A.NetClass == 'CamPower' && (A.Type == 'Track' || A.Type == 'Via') && !A.enclosedByArea('fine_U2') && !A.enclosedByArea('fine_U3')")
  (constraint track_width (min 0.15mm))
  (constraint clearance (min 0.127mm)))
(rule "gleda fine class Fine outside the fine areas"
  (condition "A.NetClass == 'Fine' && (A.Type == 'Track' || A.Type == 'Via') && !A.enclosedByArea('fine_U2') && !A.enclosedByArea('fine_U3')")
  (constraint track_width (min 0.15mm))
  (constraint clearance (min 0.127mm)))
