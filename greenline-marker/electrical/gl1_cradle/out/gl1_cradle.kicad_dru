(version 1)
# Generated by gleda from the design's net classes - do not edit.
# KiCad checks clearances per net class by itself; these rules add the
# minimum track width of each net class (and of nets with a narrower
# width override).  Later rules take precedence.
(rule "gleda min track width of net class Default"
  (condition "A.NetClass == 'Default'")
  (constraint track_width (min 0.2mm)))
(rule "gleda min track width of net class Power"
  (condition "A.NetClass == 'Power'")
  (constraint track_width (min 0.4mm)))
